DATABASE_URL=postgresql://address_ai:address_ai@postgres:5432/address_ai
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
LLM_PROVIDER=disabled
LLM_API_KEY=
SPEECH_PROVIDER=development
SPEECH_API_KEY=
MAP_PROVIDER=maplibre
SESSION_TTL_MINUTES=60
LOG_LEVEL=INFO

# Bitrix24 dry-run checker. Keep the real webhook only in .env, never commit it.
# Example: https://your-domain.bitrix24.com/rest/1/your_webhook_key
BITRIX_WEBHOOK_BASE_URL=
# Stage id for the ASIGNACION column. Example format can be C16:NEW or C16:UC_...
BITRIX_ASSIGNMENT_STAGE_ID=
# Optional funnel/category id if ASIGNACION belongs to a non-default pipeline.
BITRIX_CATEGORY_ID=
# dry_run only reports what would happen. live takes the chat and performs actions.
BITRIX_AUTOMATION_MODE=dry_run
# Token shown by Bitrix when creating an outbound webhook. Optional but recommended.
BITRIX_OUTBOUND_TOKEN=
# Token to protect the web dashboard. Open /?token=VALUE when this is set.
BITRIX_DASHBOARD_TOKEN=
# Your Bitrix user id, used for assignedById and for sending the first message in live mode.
BITRIX_OPERATOR_USER_ID=
# Stage to move the deal after taking the chat. Example: C16:UC_L8W7U1
BITRIX_TARGET_STAGE_ID=
# Optional comma-separated connector ids to accept. Leave empty to accept all.
BITRIX_ALLOWED_CONNECTORS=
# Message to send after taking the chat in live mode. Leave empty to skip sending.
BITRIX_GREETING_MESSAGE=
